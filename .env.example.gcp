# Connection settings for deploy/vm.sh. Copy to .env.gcp (gitignored) and fill in.
GCP_PROJECT=my-gcp-project
GCP_ZONE=us-west1-c
GCP_INSTANCE=my-instance-name

# Optional overrides; defaults match how the VM is currently set up (see deploy/1ns-registrar-relay.service)
#REMOTE_DIR=/opt/ens-registrar-relay
#SERVICE_NAME=1ns-registrar-relay
#SERVICE_USER=worker
#GIT_REMOTE=origin
#GIT_BRANCH=main
#HEALTH_URL=http://127.0.0.1/health
