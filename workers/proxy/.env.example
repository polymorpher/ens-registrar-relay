# Cloudflare account that owns the DNS zone of PROXY_HOSTNAME
CLOUDFLARE_ACCOUNT_ID=

# API token for that account: Workers Scripts:Edit (account), Workers Routes:Edit and DNS:Edit
# (zone). Leave empty to use an existing `wrangler login` session instead.
CLOUDFLARE_API_TOKEN=

# Worker name in Cloudflare. Reuse the same name to update an existing deployment.
WORKER_NAME=example-proxy

# Public hostname to serve. Must be a zone in the account above, or a subdomain of one.
PROXY_HOSTNAME=example.country

# Origin every request is forwarded to: scheme + host only, no path.
UPSTREAM_URL=https://my-app.some-account.workers.dev
